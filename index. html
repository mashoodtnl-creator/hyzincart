if(!/^\d{10}$/.test(g('#cP')))return $('#cX').textContent='Enter a 10 digit phone number.';if(g('#cM').length<3)return $('#cX').textContent='Enter your message.';
$('#cX').textContent='';window.open(waUrl('Hello HyzCart!\nName: '+g('#cN')+'\nEmail: '+g('#cE')+'\nPhone: '+g('#cP')+'\n'+g('#cM')),'_blank');toast('Opening WhatsApp')};
/* ====== HERO SLIDER ====== */
var sl=$$('.sl'),si=0,tm;function show(n){si=(n+sl.length)%sl.length;sl.forEach(function(s,i){s.classList.toggle('on',i===si)});$$('#dots button').forEach(function(b,i){b.setAttribute('aria-current',String(i===si))})}
function auto(){clearInterval(tm);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)tm=setInterval(function(){show(si+1)},5000)}
$('#dots').innerHTML=sl.map(function(_,i){return'<button aria-label="Slide '+(i+1)+'" data-s="'+i+'"></button>'}).join('');

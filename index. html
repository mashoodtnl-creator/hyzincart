['#aP','#aSP'].forEach(function(s){$(s).oninput=com});com();
function renderAdmin(){$('#adm').textContent=admin?'ON (tap to turn off)':'OFF (tap to turn on)';
$('#pL').innerHTML=pend.length?pend.map(function(p){return'<div class="it"><img src="'+esc(img(p))+'" alt=""><div><b>'+esc(p.name)+'</b><div>'+inr(p.price)+' | Seller '+esc(p.seller.n)+' '+esc(p.seller.w)+'</div><div class="g">Commission '+inr(p.price-p.seller.p)+'</div><button class="b by" data-ap="'+p.id+'" style="min-height:40px">Approve</button> <button class="rm" data-rj="'+p.id+'">Reject</button></div></div>'}).join(''):'<p class="pa">No pending products.</p>';
$('#lL').innerHTML=custom.length?custom.map(function(p){return'<div class="it"><img src="'+esc(img(p))+'" alt=""><div><b>'+esc(p.name)+'</b><div>'+inr(p.price)+'</div><button class="rm" data-d="'+p.id+'">Delete</button></div></div>'}).join(''):'<p class="pa">None yet.</p>'}
function persist(){return sv('hc_custom',custom)&&sv('hc_pend',pend)}
function reader(f,cb){var fr=new FileReader();fr.onload=function(){var im=new Image();im.onload=function(){var s=Math.min(1,700/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*s);c.height=Math.round(im.height*s);c.getContext('2d').drawImage(im,0,0,c.width,c.height);cb(c.toDataURL('image/jpeg',.8))};im.onerror=function(){cb('')};im.src=fr.result};fr.onerror=function(){cb('')};fr.readAsDataURL(f)}
function addProd(photo){var g=function(i){return $(i).value.trim()},pr=Number(g('#aP')),sp=Number(g('#aSP')),st=g('#aS');
var p={id:'c'+Date.now(),name:g('#aN'),price:pr,mrp:Math.max(Number(g('#aM'))||pr,pr),r:0,rv:0,cat:g('#aC')||'Nursery',stock:st===''?10:Math.max(0,parseInt(st,10)||0),desc:g('#aD'),feat:g('#aF').split('\n').map(function(x){return x.trim()}).filter(Boolean),photo:photo||g('#aU'),seller:{n:g('#aSN'),w:g('#aSW'),p:sp}};
if(admin)custom.push(p);else pend.push(p);
if(!persist()){if(admin)custom.pop();else pend.pop();$('#aX').textContent='Storage is full. Use a Photo URL instead of an upload.';return}
$('#sfm').reset();$('#aC').value='Nursery';$('#aS').value=10;com();$('#aX').textContent='';renderAdmin();renderGrid();toast(admin?'Product Added!':'Product submitted. Waiting for admin approval.');if(admin){closeAll();$('#shop').scrollIntoView()}}
$('#sfm').onsubmit=function(e){e.preventDefault();var x=$('#aX'),g=function(i){return $(i).value.trim()};
if(!g('#aN'))return x.textContent='Enter the product name.';if(!(Number(g('#aP'))>0))return x.textContent='Enter the selling price.';if(!g('#aD'))return x.textContent='Enter a description.';
if(!g('#aSN'))return x.textContent='Enter the seller name.';if(!/^\d{10,13}$/.test(g('#aSW')))return x.textContent='Enter the seller WhatsApp number (digits only).';
var sp=Number(g('#aSP'));if(!(sp>0)||sp>Number(g('#aP')))return x.textContent='Seller price must be more than 0 and not above the selling price.';
var f=$('#aI').files[0];if(f)reader(f,addProd);else addProd('')};

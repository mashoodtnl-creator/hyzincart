/* ====== EVENTS ====== */
document.addEventListener('click',function(e){var t=e.target.closest('[data-c],[data-a],[data-b],[data-w],[data-o],[data-wa],[data-cq],[data-r],[data-d],[data-ap],[data-rj],[data-t],#more,#cp');if(!t)return;var d=t.dataset;
if(d.c!==undefined){setCat(d.c,true);return}
if(d.a){toast(addC(d.a,1)?'Added to cart':'Out of stock');return}
if(d.b){if(addC(d.b,1))openCart('k');return}
if(d.w){toggleW(d.w);return}
if(d.wa){if(addC(d.wa,1)){wish=wish.filter(function(i){return i!==d.wa});save();renderWish();renderGrid();toast('Moved to cart')}return}
if(d.o){var p=find(d.o);if(p)toast(p.name+' - '+inr(p.price)+'. '+p.feat.join(', '));return}
if(d.cq){var it=cart.filter(function(i){return i.id===d.i})[0],p2=find(d.i);if(it&&p2){it.q=Math.max(1,Math.min(p2.stock,it.q+Number(d.cq)));save();renderCart()}return}
if(d.r){cart=cart.filter(function(i){return i.id!==d.r});save();renderCart();return}
if(d.d){if(confirm('Delete this product?')){custom=custom.filter(function(p){return p.id!==d.d});persist();renderAdmin();renderGrid()}return}
if(d.ap){var i2=pend.map(function(p){return p.id}).indexOf(d.ap);if(i2>=0){custom.push(pend.splice(i2,1)[0]);persist();renderAdmin();renderGrid();toast('Product approved and live')}return}
if(d.rj){pend=pend.filter(function(p){return p.id!==d.rj});persist();renderAdmin();toast('Product rejected');return}
if(d.t){e.preventDefault();window.open(waUrl('Hello HyzCart! I want to know more about the HYZIN '+d.t+' cradle.'),'_blank');return}
if(t.id==='more'){vis+=PAGE;renderGrid();return}
if(t.id==='cp'){coupon=!coupon;renderCart();return}});
